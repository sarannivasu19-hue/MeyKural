# ==========================================================
# மெய்க்குறள் (Meikkural) Environment Configuration
# ==========================================================
# Server Port
PORT=3001

# Auth
JWT_SECRET=
ADMIN_USERNAME=admin
# Set ADMIN_PASSWORD_DEFAULT before running npm run setup.
# Never commit or display this value.
ADMIN_PASSWORD_DEFAULT=

# AI LLM Provider for Strict RAG Chatbot (Optional for offline features)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=

